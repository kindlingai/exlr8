{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kindlingai.dev/schemas/exlr8-protocol/v1/claims.post.response.schema.json",
  "title": "POST /api/claims 201 response",
  "description": "Single Claim object when request omitted count, or {\"claims\": [...]} when request included count.",
  "oneOf": [
    {
      "$ref": "common.schema.json#/$defs/Claim"
    },
    {
      "type": "object",
      "required": ["claims"],
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "common.schema.json#/$defs/Claim"
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
