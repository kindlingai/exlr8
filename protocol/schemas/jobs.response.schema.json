{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kindlingai.dev/schemas/exlr8-protocol/v1/jobs.response.schema.json",
  "title": "GET /api/jobs response",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "job",
      "title",
      "model",
      "version",
      "layers",
      "experts",
      "slots",
      "uploaded",
      "claimed",
      "disabled",
      "open",
      "closed",
      "not_ready",
      "harvested",
      "ready_layers",
      "done_layers",
      "contributors",
      "last_upload",
      "weights",
      "codebooks"
    ],
    "properties": {
      "job": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string"
      },
      "model": {
        "type": "string",
        "minLength": 1,
        "description": "Human-readable model display name (models[job.model].name)."
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "layers": {
        "type": "integer",
        "minimum": 1,
        "description": "Number of MoE layers in the model (dense layers excluded)."
      },
      "experts": {
        "type": "integer",
        "minimum": 1,
        "description": "Total slots per MoE layer: routed_experts + (shared_expert ? 1 : 0)."
      },
      "slots": {
        "type": "integer",
        "minimum": 1,
        "description": "Total slots in the job (layers * experts)."
      },
      "uploaded": {
        "type": "integer",
        "minimum": 0
      },
      "claimed": {
        "type": "integer",
        "minimum": 0
      },
      "disabled": {
        "type": "integer",
        "minimum": 0
      },
      "open": {
        "type": "integer",
        "minimum": 0
      },
      "closed": {
        "type": "integer",
        "minimum": 0
      },
      "not_ready": {
        "type": "integer",
        "minimum": 0
      },
      "harvested": {
        "type": "integer",
        "minimum": 0
      },
      "ready_layers": {
        "type": "integer",
        "minimum": 0
      },
      "done_layers": {
        "type": "integer",
        "minimum": 0
      },
      "contributors": {
        "type": "integer",
        "minimum": 0
      },
      "last_upload": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ],
        "description": "Timestamp in Unix milliseconds of the most recent upload, or null."
      },
      "weights": {
        "oneOf": [
          {
            "$ref": "common.schema.json#/$defs/WeightsRef"
          },
          {
            "type": "null"
          }
        ]
      },
      "codebooks": {
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/Codebook"
        },
        "uniqueItems": true
      }
    },
    "additionalProperties": false
  }
}
