{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kindlingai.dev/schemas/exlr8-protocol/v1/piece-url.post.response.schema.json",
  "title": "POST /api/claims/{job}/{layer}/{expert}/piece-url response",
  "type": "object",
  "required": ["url", "method", "headers", "expires_in"],
  "properties": {
    "url": {
      "type": "string",
      "format": "uri",
      "description": "SigV4 presigned S3 PUT URL bound to Content-Length. Do not send the site Authorization header to this URL."
    },
    "method": {
      "const": "PUT"
    },
    "headers": {
      "type": "object",
      "required": ["Content-Length"],
      "properties": {
        "Content-Length": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "additionalProperties": false
    },
    "expires_in": {
      "type": "integer",
      "minimum": 3600,
      "maximum": 604800,
      "description": "Presigned URL lifetime in seconds."
    }
  },
  "additionalProperties": false
}
