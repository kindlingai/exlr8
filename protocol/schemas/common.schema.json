{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kindlingai.dev/schemas/exlr8-protocol/v1/common.schema.json",
  "title": "exlr8 quant site protocol v1 shared definitions",
  "$defs": {
    "Error": {
      "type": "object",
      "description": "JSON error body returned with 4xx and 5xx responses.",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "Codebook": {
      "type": "string",
      "enum": ["mcg", "mul1", "pmcgx"]
    },
    "Width": {
      "type": "integer",
      "enum": [2, 3, 4]
    },
    "LayerRange": {
      "type": "string",
      "pattern": "^[0-9]+(-[0-9]+)?$",
      "description": "Single layer index \"N\" or inclusive range \"A-B\"."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase 64-character hex SHA-256 digest."
    },
    "GitCommit40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full 40-character lowercase hex git commit SHA."
    },
    "EncoderId": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}(-unchecked)?$",
      "description": "Git commit hash of an encoder build (7-40 lowercase hex chars), optionally suffixed with \"-unchecked\". Builds ending in \"-dirty\" are refused with 426."
    },
    "WeightsRef": {
      "type": "object",
      "description": "Hugging Face checkpoint reference for a model.",
      "required": ["hf", "revision"],
      "properties": {
        "hf": {
          "type": "string",
          "minLength": 1,
          "description": "Hugging Face repository id (\"org/repo\")."
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "description": "Pinned repository revision (commit SHA, tag, or branch)."
        },
        "id": {
          "$ref": "#/$defs/Sha256Hex",
          "description": "SHA-256 of config.json bytes followed immediately by model.safetensors.index.json bytes."
        }
      },
      "additionalProperties": false
    },
    "Model": {
      "type": "object",
      "description": "Model geometry and source weights reference.",
      "required": [
        "name",
        "layers",
        "hidden_size",
        "moe_intermediate_size",
        "routed_experts",
        "shared_expert"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "layers": {
          "type": "integer",
          "minimum": 1
        },
        "hidden_size": {
          "type": "integer",
          "minimum": 128,
          "multipleOf": 128
        },
        "moe_intermediate_size": {
          "type": "integer",
          "minimum": 128,
          "multipleOf": 128
        },
        "moe_layers": {
          "$ref": "#/$defs/LayerRange",
          "description": "Inclusive range of layers with experts. Absent means all layers 0-(layers-1)."
        },
        "routed_experts": {
          "type": "integer",
          "minimum": 1
        },
        "shared_expert": {
          "type": "boolean"
        },
        "weights": {
          "$ref": "#/$defs/WeightsRef"
        }
      },
      "additionalProperties": false
    },
    "PerWidthCodebooks": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^k[234]$": {
          "$ref": "#/$defs/Codebook"
        }
      },
      "additionalProperties": false
    },
    "PlanEntry": {
      "type": "object",
      "description": "Codebook and encode plan covering a layer range. When multiple entries cover a layer, the last one wins.",
      "required": ["layers", "codebook"],
      "properties": {
        "layers": {
          "$ref": "#/$defs/LayerRange"
        },
        "widths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Width"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "shared_widths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Width"
          },
          "uniqueItems": true
        },
        "damping": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "codebook": {
          "oneOf": [
            {
              "$ref": "#/$defs/Codebook"
            },
            {
              "$ref": "#/$defs/PerWidthCodebooks"
            }
          ]
        },
        "refine": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 127
          }
        }
      },
      "additionalProperties": false
    },
    "EncodeBlock": {
      "type": "object",
      "description": "Resolved per-layer encode parameters returned with a claim.",
      "required": [
        "hessian_id",
        "widths",
        "shared_widths",
        "damping",
        "codebooks",
        "refine",
        "args"
      ],
      "properties": {
        "hessian_id": {
          "type": "string",
          "minLength": 1
        },
        "widths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Width"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "shared_widths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Width"
          },
          "uniqueItems": true
        },
        "damping": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "codebooks": {
          "$ref": "#/$defs/PerWidthCodebooks"
        },
        "refine": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 127
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Flat list of alternating CLI flag/value pairs for exlr8enc."
        }
      },
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "description": "A claimed (job, layer, expert) slot with Hessian download URLs, piece upload URLs, and resolved encode parameters.",
      "required": [
        "job",
        "job_version",
        "model",
        "weights_id",
        "layer",
        "expert",
        "shared",
        "expires_at",
        "hessians",
        "upload",
        "encode"
      ],
      "properties": {
        "job": {
          "type": "string",
          "minLength": 1
        },
        "job_version": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Model key in /api/config models."
        },
        "weights_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Sha256Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "expert": {
          "type": "integer",
          "minimum": 0
        },
        "shared": {
          "type": "boolean"
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "description": "Claim expiration timestamp in Unix milliseconds."
        },
        "hessians": {
          "type": "object",
          "required": ["shared"],
          "properties": {
            "expert": {
              "type": "string",
              "format": "uri"
            },
            "shared": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "upload": {
          "type": "string",
          "format": "uri",
          "description": "URL for direct through-site PUT upload."
        },
        "upload_url": {
          "type": "string",
          "format": "uri",
          "description": "Present only for S3 pieces stores: POST here to obtain a presigned PUT URL."
        },
        "upload_done": {
          "type": "string",
          "format": "uri",
          "description": "Present only for S3 pieces stores: POST here after completing the presigned PUT."
        },
        "encode": {
          "$ref": "#/$defs/EncodeBlock"
        }
      },
      "dependentRequired": {
        "upload_url": ["upload_done"],
        "upload_done": ["upload_url"]
      },
      "if": {
        "properties": {
          "shared": {
            "const": true
          }
        },
        "required": ["shared"]
      },
      "then": {
        "properties": {
          "hessians": {
            "not": {
              "required": ["expert"]
            }
          }
        }
      },
      "else": {
        "properties": {
          "hessians": {
            "required": ["expert"]
          }
        }
      },
      "additionalProperties": false
    },
    "PieceReply": {
      "type": "object",
      "description": "Confirmation returned when a piece upload is recorded or re-confirmed on idempotent retry.",
      "required": ["job", "layer", "expert", "size", "md5"],
      "properties": {
        "job": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "expert": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "description": "Piece file length in bytes."
        },
        "md5": {
          "type": "string",
          "description": "Hex MD5 for R2 stores, or unquoted store ETag for S3 stores."
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex",
          "description": "Present only when recorded via POST .../piece-done with a sha256 field."
        }
      },
      "additionalProperties": false
    }
  }
}
