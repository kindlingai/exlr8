{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kindlingai.dev/schemas/exlr8-protocol/v1/config.response.schema.json",
  "title": "GET /api/config response",
  "type": "object",
  "required": ["default_job", "models", "jobs", "codebooks"],
  "properties": {
    "default_job": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/Model"
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "active",
          "model",
          "hessian_id",
          "widths",
          "shared_widths",
          "damping",
          "codebooks"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "active": {
            "type": "boolean"
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "hessian_id": {
            "type": "string",
            "minLength": 1
          },
          "widths": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/Width"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "shared_widths": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/Width"
            },
            "uniqueItems": true
          },
          "damping": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "codebooks": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/PlanEntry"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "codebooks": {
      "type": "object",
      "description": "Maps each codebook short name to the required prefix in a piece file's codebook / codebook_kN metadata.",
      "required": ["mcg", "mul1", "pmcgx"],
      "properties": {
        "mcg": {
          "type": "string",
          "minLength": 1
        },
        "mul1": {
          "type": "string",
          "minLength": 1
        },
        "pmcgx": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
