{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kindlingai.dev/schemas/exlr8-protocol/v1/piece-url.post.request.schema.json",
  "title": "POST /api/claims/{job}/{layer}/{expert}/piece-url request",
  "type": "object",
  "required": ["size"],
  "properties": {
    "size": {
      "type": "integer",
      "minimum": 9,
      "description": "Exact piece file length in bytes (must exceed the 8-byte safetensors header length prefix and not exceed maxPieceBytes)."
    }
  },
  "additionalProperties": false
}
