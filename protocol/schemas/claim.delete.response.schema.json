{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kindlingai.dev/schemas/exlr8-protocol/v1/claim.delete.response.schema.json",
  "title": "DELETE /api/claims/{job}/{layer}/{expert} response",
  "type": "object",
  "required": ["job", "layer", "expert", "released"],
  "properties": {
    "job": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "type": "integer",
      "minimum": 0
    },
    "expert": {
      "type": "integer",
      "minimum": 0
    },
    "released": {
      "const": true
    }
  },
  "additionalProperties": false
}
