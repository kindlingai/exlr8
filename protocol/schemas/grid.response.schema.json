{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kindlingai.dev/schemas/exlr8-protocol/v1/grid.response.schema.json",
  "title": "GET /api/grid response",
  "type": "object",
  "required": [
    "job",
    "jobs",
    "model",
    "title",
    "layers",
    "experts",
    "shared",
    "ready",
    "hessians",
    "moe",
    "plans",
    "slots"
  ],
  "properties": {
    "job": {
      "type": "string",
      "minLength": 1
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model key in /api/config models."
    },
    "title": {
      "type": "string"
    },
    "layers": {
      "type": "integer",
      "minimum": 1,
      "description": "Total layer count in the model, including dense layers."
    },
    "experts": {
      "type": "integer",
      "minimum": 1,
      "description": "Slots per MoE layer: routed_experts + (shared_expert ? 1 : 0)."
    },
    "shared": {
      "type": "integer",
      "minimum": -1,
      "description": "Slot index of the shared expert (routed_experts), or -1 if the model has no shared expert."
    },
    "ready": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "hessians": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "moe": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "description": "Inclusive [first_moe_layer, last_moe_layer] range."
    },
    "plans": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "common.schema.json#/$defs/PerWidthCodebooks"
          }
        ]
      },
      "description": "Per-layer codebook map indexed by layer (null for dense layers)."
    },
    "slots": {
      "type": "array",
      "description": "Non-open slots as [layer, expert, state, login_or_null, mine] tuples.",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "string",
            "enum": ["claimed", "uploaded", "disabled"]
          },
          {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          {
            "type": "integer",
            "enum": [0, 1]
          }
        ],
        "minItems": 5,
        "maxItems": 5
      }
    }
  },
  "additionalProperties": false
}
